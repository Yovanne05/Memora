SQLALCHEMY_DATABASE_URI=sqlite:///app.db
SWAGGER_ENABLED=1
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400
ALLOWED_ORIGINS=http://localhost:5173

# Redis (for real-time collaboration)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
COLLAB_SESSION_TTL_SECONDS=86400

# Uploads
IMAGE_MAX_CONTENT_LENGTH_BYTES=5242880
STORAGE_DRIVER=local
UPLOAD_LOCAL_ROOT=uploads
# Optional base URL for serving local uploads directly (otherwise the API serves them)
UPLOAD_PUBLIC_BASE_URL=http://localhost:5000/uploads

# S3-compatible storage (used when STORAGE_DRIVER=s3, e.g. SeaweedFS)
STORAGE_S3_BUCKET=memora-uploads
STORAGE_S3_ENDPOINT_URL=http://localhost:8333
STORAGE_S3_REGION=eu-west-1
STORAGE_S3_ACCESS_KEY=memora
STORAGE_S3_SECRET_KEY=memora-secret
# Optional: set if you expose the bucket via CDN/front door (or want direct S3 URLs locally)
STORAGE_S3_PUBLIC_BASE_URL=http://localhost:8333/memora-uploads

# Example Postgres connection (optional)
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:password@localhost:5432/memora
