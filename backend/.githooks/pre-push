#!/bin/sh
set -e

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python_bin=""
if command -v python >/dev/null 2>&1; then
  python_bin="python"
elif command -v python3 >/dev/null 2>&1; then
  python_bin="python3"
else
  echo "python is required to run pytest. Activate your virtualenv and try again."
  exit 1
fi

echo "Running backend pytest before push..."
"$python_bin" -m pytest
