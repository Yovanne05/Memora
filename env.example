APP_ENV=dev || test
SQLALCHEMY_DATABASE_URI='postgresql+psycopg2://postgres:root@localhost:5432/memora'
SQLALCHEMY_TEST_DATABASE_URI='postgresql+psycopg2://postgres:root@localhost:5432/memora_test'
SWAGGER_ENABLED='1'
JWT_SECRET_KEY='change-me'
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400
LOGIN_RATE_LIMIT='5 per 15 minutes'

# Uploads
IMAGE_MAX_CONTENT_LENGTH_BYTES=5242880
STORAGE_DRIVER='local' # local | s3
UPLOAD_LOCAL_ROOT='uploads'
# Optional base URL for serving local uploads directly (otherwise the API serves them)
UPLOAD_PUBLIC_BASE_URL=''

# S3-compatible storage (used when STORAGE_DRIVER=s3, e.g. SeaweedFS)
STORAGE_S3_BUCKET=''
STORAGE_S3_ENDPOINT_URL=''
STORAGE_S3_REGION='eu-west-1'
STORAGE_S3_ACCESS_KEY=''
STORAGE_S3_SECRET_KEY=''
# Optional: set if you expose the bucket via CDN/front door
STORAGE_S3_PUBLIC_BASE_URL=''
# Lifetime of generated presigned URLs
STORAGE_S3_URL_EXPIRATION_SECONDS=3600
